{
  "version": "simple-cost-v1.1",
  "supersedes": "simple-cost-v1",
  "revision_reason": "correctness: implement plan 7.5 selection result type width; no PPA-based retuning",
  "evaluation_stage": "post_BEOPT_region_check_candidate_expansion_and_frozen_cleanup_before_scheduling",
  "physical_data_allowed": false,
  "units": {"delay": "abstract", "area": "abstract"},
  "width_rule_version": "effective-width-v2",
  "normalization_version": "scalar-normalized-beir-v1",
  "effective_width": "highest_bit_not_proven_zero_plus_one; minimum_1; only_verified_static_facts",
  "mul_width": "max(effective_lhs,effective_rhs,result_type_width)",
  "selection_width": "max(effective_data_alternatives,result_type_width); proven_high_zero_result_bits_do_not_shrink_type_width",
  "selection_operations": ["Ite", "Case", "Lookup", "ArrayAccess"],
  "other_width": "max(effective_data_operands,effective_result)",
  "h": "max(1,ceil(log2(w+1)))",
  "formulas": {
    "wiring": ["0", "0"],
    "bitwise_or_two_way_selection": ["1", "w"],
    "add_sub_carry_compare_negate": ["h(w)", "w"],
    "multiply": ["3*h(w)", "m*n"],
    "divide_modulo": ["w*h(w)", "w*w"],
    "dynamic_shift_slice_update_reduce": ["h(w)", "w*h(w)"],
    "k_way_selection": ["max(1,ceil(log2(k)))", "k*w"]
  },
  "register_bit_cost": 1,
  "relative_delay_limit": {"numerator": 105, "denominator": 100},
  "constant_subgraph_cost": [0, 0],
  "Case": "ordered_priority; k=condition_value_pairs+default; no_assumed_balanced_tree",
  "Lookup": "conservative_reachable_indices_after_explicit_index_normalization; no_value_deduplication",
  "unsafe_lookup": "reject_until_defined_lowering",
  "shared_divrem": "count_shared_implementation_once_only_with_explicit_implementation_id",
  "unknown_operation": "reject",
  "single_candidate": "minimize_register_bits_by_legal_group_moves_within_105_over_100_T0; combinational_graph_fixed",
  "candidate_score": ["maximum_stage_abstract_delay", "abstract_combinational_cost_plus_register_bits", "register_bits", "register_count", "candidate_id"],
  "candidate_enumeration": "same_ordered_configuration_ids_for_C_and_D_before_budget_truncation",
  "tie_break": "stable_node_or_group_id_then_stage; integer_costs_and_exact_rational_limits",
  "physical_target_in_BC": "not_read",
  "physical_feedback_in_BC": "not_read; measured_failure_does_not_trigger_reselection",
  "experimental_groups": {
    "A": "unsplit_combinational_datapath_with_boundary_registers",
    "B": "atomic_operations_with_simple_cost_and_fixed_L",
    "C": "declared_internal_boundaries_with_simple_cost_and_fixed_L",
    "D": "same_candidates_and_L; physical_model_and_budgeted_feedback"
  }
}
