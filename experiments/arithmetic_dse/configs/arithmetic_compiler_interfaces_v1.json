{
  "version": "arithmetic-compiler-interfaces-v1",
  "request_version": "arithmetic-request-v1",
  "report_version": "arithmetic-structure-report-v2",
  "backend_contract": "native-beir-contract-v1",
  "feature_schema": "beir-cost-features-v1",
  "entrypoints": [
    "rtlzz::CompileOptions",
    "PipelineV2::PipelineConfig",
    "VUL bridge",
    "predicate-expand --arithmetic-request",
    "vulrtlgen --arithmetic-request"
  ],
  "providers": {
    "core-original-v1": {
      "Mul": "mul-original-v1; unsigned typed operands; atomic",
      "F32MulRNE": "softfloat3d-bitvector-mul-v1; real bit-vector expansion; atomic",
      "Div": "udiv-original-v1; unsigned equal-width <=128; statically nonzero divisor; atomic",
      "Mod": "umod-original-v1; unsigned equal-width <=128; statically nonzero divisor; atomic"
    },
    "mul-candidates-v1": {
      "Mul": "original, half and quarter through mul-block-tree-v1; deterministic K=16",
      "F32MulRNE": "unchanged atomic implementation",
      "Div_Mod": "same atomic original operators; no internal division groups"
    },
    "mul-template-v1": {
      "Mul": "forced diagnostic block_width 2..128, eligibility checked per occurrence; not formal C"
    },
    "ordinary_helpers": {
      "UDivRemShared": "registered library helper inlines one Div plus quotient-reuse low Mul/Sub; each actual primitive billed; no fused DivRem opcode or discount"
    }
  },
  "cost_modes": {
    "fixed": "fixed-op-width-v1; independent abstract delay/comb; state one per saved bit",
    "backend-model": "native offline coefficients/trees; explicit platform/profile/model hash and validated joint domain; physical ps/um2; no backend or fixed-cost fallback"
  },
  "later_steps": {
    "step6": [],
    "step7": [
      "four-platform model fitting, independent quality and stage/state validation; currently in progress",
      "64/128, Div/Mod, binary32 and additional contexts remain individually admitted domains"
    ],
    "step6_capacity": [
      "original UDR1.5ns timeout retained; UDR100ns and F2grt completion are bounded capacity diagnostics, never training labels",
      "other platform/scale domains require their own finite admission"
    ]
  },
  "extensions": "AES/Sigmoid/fixedpoint/new semantic profiles are reserved and explicitly rejected; no empty providers",
  "no_physical_calls": true,
