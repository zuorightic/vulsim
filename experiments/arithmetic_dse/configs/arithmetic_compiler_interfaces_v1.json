  "report_type_policy": "Strict JSON tokens, no string/float/bool coercion for integer counters; uint64 counters; node identities and limb words remain intentional decimal strings. Only key fields are covered; additional report fields are permitted.",
  "report_v1_history": "Frozen reports retain their original string register_bits; only the archived v1 reader interprets them. Current emission and validation use report v2.",
  "implemented_step5": [
    "unsigned parameterized partial products and carry-preserving reduction levels",
    "fixed C candidate enumeration and scoring",
    "group placement/move evidence and diagnostic explicit templates",
    "retired legacy simple_cost and split16 options"
  ],
  "capability_policy": "C/D candidate enumeration is shared; covered/evaluated and selected flags are separate. Only the final chosen model candidate has D_selected. Numerical/physical states require separate evidence.",
