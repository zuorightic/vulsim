#include "header.uh"
INTERFACE(){SERVICE(push,ARG(CaseInput) value,ARG(bool) v);QUERY(result,CaseOutput);QUERY(valid,bool);}
USE_VERSION(main);VERSION(main){
PIPELINE(core,2,IREG(a,Int<32>){a=Int<32>(2147483701ull);},IREG(d,Int<32>){d=Int<32>(0ull);},IREG(bias,Int<32>){bias=Int<32>(2147483701ull);},IREG(bypass,Int<32>){bypass=Int<32>(2147483701ull);},IREG(sel,bool){sel=true;},IVALID(iv),OREG(y,Int<32>),OREG(r,Int<32>),OVALID(ov)){
    Int<32> n_first_one = Int<32>(1ull);
    Int<32> n_first_ones = ~Int<32>(0);
    Int<32> n_first_zero = Int<32>(0ull);
    bool n_first_is_zero = (d == n_first_zero);
    Int<32> n_first_safe_d = (n_first_is_zero ? n_first_one : d);
    Int<32> n_first_raw_q = (a / n_first_safe_d);
    Int<32> n_first_raw_r = (a % n_first_safe_d);
    Int<32> n_first_q = (n_first_is_zero ? n_first_ones : n_first_raw_q);
    Int<32> n_first_r = (n_first_is_zero ? a : n_first_raw_r);
    Int<32> n_biased_q = (Int<32>(n_first_q) + Int<32>(bias));
    Int<32> n_chosen = (sel ? n_biased_q : bypass);
    y = n_chosen;
    r = n_first_r;

}
SERVICE(push,ARG(CaseInput) value,ARG(bool) v){a.setnext(value.a);d.setnext(value.d);bias.setnext(value.bias);bypass.setnext(value.bypass);sel.setnext(value.select);iv.setnext(v);}
QUERY(result,CaseOutput){return CaseOutput{y,r};}QUERY(valid,bool){return ov;}
}
