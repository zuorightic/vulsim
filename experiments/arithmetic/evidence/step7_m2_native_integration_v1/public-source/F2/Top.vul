#include "header.uh"
INTERFACE(){SERVICE(push,ARG(CaseInput) value,ARG(bool) v);QUERY(result,CaseOutput);QUERY(valid,bool);}
USE_VERSION(main);VERSION(main){
PIPELINE(core,3,IREG(a,Int<32>){a=Int<32>(2139095040ull);},IREG(b,Int<32>){b=Int<32>(0ull);},IREG(c,Int<32>){c=Int<32>(1065353216ull);},IVALID(iv),OREG(bits,Int<32>),OREG(flags,Int<5>),OVALID(ov)){
    Int<37> n_fp1 = vularith::F32MulRNE(a, b);
    Int<32> n_bits1 = Int<32>((n_fp1 >> 0u));
    Int<5> n_flags1 = Int<5>((n_fp1 >> 32u));
    Int<37> n_fp2 = vularith::F32MulRNE(n_bits1, c);
    Int<32> n_bits2 = Int<32>((n_fp2 >> 0u));
    Int<5> n_flags2 = Int<5>((n_fp2 >> 32u));
    Int<5> n_flags_or = (n_flags1 | n_flags2);
    bits = n_bits2;
    flags = n_flags_or;

}
SERVICE(push,ARG(CaseInput) value,ARG(bool) v){a.setnext(value.a);b.setnext(value.b);c.setnext(value.c);iv.setnext(v);}
QUERY(result,CaseOutput){return CaseOutput{bits,flags};}QUERY(valid,bool){return ov;}
}
