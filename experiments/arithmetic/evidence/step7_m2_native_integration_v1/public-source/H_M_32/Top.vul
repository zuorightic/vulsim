#include "header.uh"
INTERFACE(){SERVICE(push,ARG(CaseInput) value,ARG(bool) v);QUERY(result,CaseOutput);QUERY(valid,bool);}
USE_VERSION(main);VERSION(main){
PIPELINE(core,2,IREG(a,Int<32>){a=Int<32>(2147483701ull);},IREG(b,Int<32>){b=Int<32>(2147483701ull);},IREG(c,Int<32>){c=Int<32>(2147483701ull);},IREG(sel,bool){sel=true;},IVALID(iv),OREG(y,Int<32>),OVALID(ov)){
    Int<32> n_zero = Int<32>(0ull);
    Int<32> n_chosen_c = (sel ? c : n_zero);
    Int<32> n_product = (a * b);
    Int<32> n_sum = (Int<32>(n_product) + Int<32>(n_chosen_c));
    y = n_sum;

}
SERVICE(push,ARG(CaseInput) value,ARG(bool) v){a.setnext(value.a);b.setnext(value.b);c.setnext(value.c);sel.setnext(value.select);iv.setnext(v);}
QUERY(result,CaseOutput){return CaseOutput{y};}QUERY(valid,bool){return ov;}
}
