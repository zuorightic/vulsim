{
  "version": "mul-comb-sensitivity-v1",
  "purpose": "predeclared_selection_diagnostic; not_main_C_or_extra_PPA_group",
  "families": [
    "MUL",
    "MAC"
  ],
  "widths": [
    8,
    16,
    32,
    64,
    128
  ],
