INTERFACE() { SERVICE(calculate, ARG(CaseInput) value, RESP(CaseOutput) result); }
SERVICE(calculate, ARG(CaseInput) value, RESP(CaseOutput) result) {
    Int<128> n_product = (value.a * value.b);
    Int<128> n_product2 = (value.c * value.d);
    Int<129> n_wide_p = Int<129>(n_product);
    Int<129> n_wide_q = Int<129>(n_product2);
    Int<129> n_sum = (Int<129>(n_wide_p) + Int<129>(n_wide_q));
    result.y = n_sum;
}
