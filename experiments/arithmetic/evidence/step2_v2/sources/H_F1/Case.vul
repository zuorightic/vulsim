INTERFACE() { SERVICE(calculate, ARG(CaseInput) value, RESP(CaseOutput) result); }
SERVICE(calculate, ARG(CaseInput) value, RESP(CaseOutput) result) {
    Int<5> n_zero_flags = Int<5>(0ull);
    Int<37> n_fp1 = vularith::F32MulRNE(value.a, value.b);
    Int<32> n_bits1 = Int<32>((n_fp1 >> 0u));
    Int<5> n_flags1 = Int<5>((n_fp1 >> 32u));
    Int<32> n_selected_bits = (value.select ? n_bits1 : value.bypass);
    Int<5> n_selected_flags = (value.select ? n_flags1 : n_zero_flags);
    result.bits = n_selected_bits;
    result.flags = n_selected_flags;
}
