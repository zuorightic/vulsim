INTERFACE() { SERVICE(calculate, ARG(CaseInput) value, RESP(CaseOutput) result); }
SERVICE(calculate, ARG(CaseInput) value, RESP(CaseOutput) result) {
    Int<64> n_product = (value.a * value.b);
    Int<64> n_product2 = (value.c * value.d);
    Int<65> n_wide_p = Int<65>(n_product);
    Int<65> n_wide_q = Int<65>(n_product2);
    Int<65> n_sum = (Int<65>(n_wide_p) + Int<65>(n_wide_q));
    result.y = n_sum;
}
