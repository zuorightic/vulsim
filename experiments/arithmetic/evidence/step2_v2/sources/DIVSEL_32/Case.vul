INTERFACE() { SERVICE(calculate, ARG(CaseInput) value, RESP(CaseOutput) result); }
SERVICE(calculate, ARG(CaseInput) value, RESP(CaseOutput) result) {
    Int<32> n_first_one = Int<32>(1ull);
    Int<32> n_first_ones = ~Int<32>(0);
    Int<32> n_first_zero = Int<32>(0ull);
    bool n_first_is_zero = (value.d == n_first_zero);
    Int<32> n_first_safe_d = (n_first_is_zero ? n_first_one : value.d);
    Int<32> n_first_raw_q = (value.a / n_first_safe_d);
    Int<32> n_first_raw_r = (value.a % n_first_safe_d);
    Int<32> n_first_q = (n_first_is_zero ? n_first_ones : n_first_raw_q);
    Int<32> n_first_r = (n_first_is_zero ? value.a : n_first_raw_r);
    Int<32> n_biased_q = (Int<32>(n_first_q) + Int<32>(value.bias));
    Int<32> n_chosen = (value.select ? n_biased_q : value.bypass);
    result.y = n_chosen;
    result.r = n_first_r;
}
