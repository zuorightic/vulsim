INTERFACE() { SERVICE(calculate, ARG(CaseInput) value, RESP(CaseOutput) result); }
SERVICE(calculate, ARG(CaseInput) value, RESP(CaseOutput) result) {
    Int<256> n_product = (value.a * value.b);
    Int<256> n_product2 = (value.c * value.d);
    Int<257> n_wide_p = Int<257>(n_product);
    Int<257> n_wide_q = Int<257>(n_product2);
    Int<257> n_sum = (Int<257>(n_wide_p) + Int<257>(n_wide_q));
    result.y = n_sum;
}
