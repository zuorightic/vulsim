INTERFACE() { SERVICE(calculate, ARG(CaseInput) value, RESP(CaseOutput) result); }
SERVICE(calculate, ARG(CaseInput) value, RESP(CaseOutput) result) {
    Int<5> n_limit = Int<5>(8ull);
    Int<8> n_mod_one = Int<8>(1ull);
    Int<8> n_mod_ones = ~Int<8>(0);
    Int<8> n_mod_zero = Int<8>(0ull);
    Int<8> n_zero = Int<8>(0ull);
    Int<5> n_zero_s = Int<5>(0ull);
    bool n_in_range = (value.s < n_limit);
    Int<8> n_inverse_mask = ~value.mask;
    bool n_less = (value.a < value.b);
    bool n_mod_is_zero = (value.d == n_mod_zero);
    Int<8> n_u = (Int<8>(value.a) + Int<8>(value.b));
    Int<8> n_v = (Int<8>(value.a) - Int<8>(value.b));
    Int<8> n_mod_safe_d = (n_mod_is_zero ? n_mod_one : value.d);
    Int<5> n_safe_s = (n_in_range ? value.s : n_zero_s);
    Int<8> n_mod_raw_r = (value.a % n_mod_safe_d);
    Int<8> n_raw_l = (n_u << n_safe_s.to<uint32_t>());
    Int<8> n_raw_r = (n_v >> n_safe_s.to<uint32_t>());
    Int<8> n_left = (n_in_range ? n_raw_l : n_zero);
    Int<8> n_mod_r = (n_mod_is_zero ? value.a : n_mod_raw_r);
    Int<8> n_right = (n_in_range ? n_raw_r : n_zero);
    Int<8> n_masked_l = (n_left & value.mask);
    Int<8> n_masked_r = (n_right & n_inverse_mask);
    Int<8> n_merged = (n_masked_l | n_masked_r);
    Int<8> n_answer = (n_merged ^ n_mod_r);
    result.y = n_answer;
    result.less = n_less;
}
