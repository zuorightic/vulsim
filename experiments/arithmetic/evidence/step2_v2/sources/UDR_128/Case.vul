INTERFACE() { SERVICE(calculate, ARG(CaseInput) value, RESP(CaseOutput) result); }
SERVICE(calculate, ARG(CaseInput) value, RESP(CaseOutput) result) {
    Int<128> n_first_one = Int<128>(1ull);
    Int<128> n_first_ones = ~Int<128>(0);
    Int<128> n_first_zero = Int<128>(0ull);
    bool n_first_is_zero = (value.d == n_first_zero);
    Int<128> n_first_safe_d = (n_first_is_zero ? n_first_one : value.d);
    Int<128> n_first_raw_q = (value.a / n_first_safe_d);
    Int<128> n_first_raw_r = (value.a % n_first_safe_d);
    Int<128> n_first_q = (n_first_is_zero ? n_first_ones : n_first_raw_q);
    Int<128> n_first_r = (n_first_is_zero ? value.a : n_first_raw_r);
    result.q = n_first_q;
    result.r = n_first_r;
}
