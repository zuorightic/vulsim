INTERFACE() { SERVICE(calculate, ARG(CaseInput) value, RESP(CaseOutput) result); }
SERVICE(calculate, ARG(CaseInput) value, RESP(CaseOutput) result) {
    Int<16> n_zero = Int<16>(0ull);
    Int<16> n_chosen_c = (value.select ? value.c : n_zero);
    Int<16> n_product = (value.a * value.b);
    Int<16> n_sum = (Int<16>(n_product) + Int<16>(n_chosen_c));
    result.y = n_sum;
}
