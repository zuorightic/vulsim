        "-c",
        "import copy,json\nfrom pathlib import Path\nfrom tempfile import TemporaryDirectory\nfrom experiments.arithmetic_dse.model_m2_mux_fit import extract\nfrom experiments.arithmetic_dse.model_m2_mux_static_features import descriptor,features\nfrom experiments.arithmetic_dse.model_m2_mux_static_query import query\nfrom experiments.arithmetic_dse.model_m2_mux_static_fit import predict\nfrom experiments.arithmetic_dse.model_collection import sha,write\nb=Path(\"build/step7-m2-models-20261105\"); read=lambda p:json.loads(Path(p).read_text())\nfit=read(b/\"mux-static-data-v1.json\")\nwith TemporaryDirectory() as td:\n    p=Path(td)/\"raw.json\";extract((b/\"mux-context-v1\").resolve(),p)\n    if read(p)!=read(b/\"mux-fitting-data-v1.json\"):raise ValueError(\"fitting raw replay differs\")\nfor r in fit[\"rows\"]:\n    cut=fit[\"static_contexts\"][r[\"static_context_sha256\"]]\n    if features(r[\"features\"],cut,r[\"spec\"][\"id\"])!=r[\"static_features\"]:raise ValueError(\"changed static features\")\nbundle=read(b/\"mux-static-publication-v1/asap7-primitives.json\");test=read(b/\"mux-static-independent-data-v1.json\")\ncount=0;first=None\nfor r in test[\"rows\"]:\n    if r[\"stage\"]!=\"grt\" or r[\"spec\"][\"fanout\"]!=1:continue\n    cut=test[\"static_contexts\"][r[\"static_context_sha256\"]]\n    actual=query(bundle,r[\"features\"],cut,r[\"spec\"][\"id\"],profile_sha256=bundle[\"platform_profile_sha256\"])\n    for q,key in ((\"delay\",\"delay_ps\"),(\"area\",\"comb_area_um2\")):\n        if actual[key]!=predict(bundle[\"stages\"][\"grt\"][\"operations\"][\"mux\"][q],r,q):raise ValueError(\"published production query differs\")\n    if actual[\"PPA_calls\"]:raise ValueError(\"query launched PPA\")\n    count+=1\n    if first is None:first=(r,cut)\nr,cut=first;rejected=[]\nfor label,model,base,ctx,profile in [\n    (\"missing_context\",bundle,r[\"features\"],None,bundle[\"platform_profile_sha256\"]),\n    (\"wrong_profile\",bundle,r[\"features\"],cut,\"wrong\"),\n    (\"wrong_target\",bundle,{**r[\"features\"],\"sdc_period_ps\":1234},cut,bundle[\"platform_profile_sha256\"]),\n    (\"unqualified\",{**bundle,\"quality_status\":\"awaiting_independent_test\"},r[\"features\"],cut,bundle[\"platform_profile_sha256\"])]:\n    try:query(model,base,ctx,r[\"spec\"][\"id\"],profile_sha256=profile)\n    except ValueError:rejected.append(label)\n    else:raise ValueError(\"unqualified production query accepted: \"+label)\nlegacy=next(v for v in fit[\"rows\"] if v[\"source_context\"]==\"legacy_mixed_control\" and v[\"spec\"][\"fanout\"]==1)\ntry:query(bundle,legacy[\"features\"],fit[\"static_contexts\"][legacy[\"static_context_sha256\"]],legacy[\"spec\"][\"id\"],profile_sha256=bundle[\"platform_profile_sha256\"])\nexcept ValueError:rejected.append(\"mixed_control_no_independent_qualification\")\nelse:raise ValueError(\"unqualified legacy mixed context accepted\")\nresult={\"status\":\"passed\",\"fitting_raw_measurements\":192,\"fitting_main_rows\":768,\"independent_query_rows\":count,\"PPA_calls\":0,\"rejections\":rejected,\"published_model_sha256\":sha(b/\"mux-static-publication-v1/asap7-primitives.json\"),\"full_D_ready\":False}\nwrite(b/\"mux-static-verdict-work-v1/raw-fitting-and-production-query.json\",result);print(json.dumps(result))\n"
