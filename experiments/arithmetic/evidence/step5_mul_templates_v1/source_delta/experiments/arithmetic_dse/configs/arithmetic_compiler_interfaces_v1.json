{
  "version": "arithmetic-compiler-interfaces-v1",
  "request_version": "arithmetic-request-v1",
  "report_version": "arithmetic-structure-report-v2",
  "backend_contract": "native-beir-contract-v1",
  "feature_schema": "beir-cost-features-v1",
  "entrypoints": [
    "rtlzz::CompileOptions",
    "PipelineV2::PipelineConfig",
    "VUL bridge",
    "predicate-expand --arithmetic-request",
    "vulrtlgen --arithmetic-request"
  ],
  "providers": {
    "core-original-v1": {
      "Mul": "mul-original-v1; unsigned typed operands; atomic",
      "F32MulRNE": "softfloat3d-bitvector-mul-v1; real bit-vector expansion; atomic"
    },
    "mul-candidates-v1": {
      "Mul": "original, half and quarter through mul-block-tree-v1; deterministic K=16",
      "F32MulRNE": "unchanged atomic implementation"
    },
    "mul-template-v1": {
      "Mul": "forced diagnostic block_width 2..128, eligibility checked per occurrence; not formal C"
    }
  },
  "cost_modes": {
    "fixed": "fixed-op-width-v1; independent abstract delay/comb; state one per saved bit",
    "backend-model": "query identity and fail-closed rejection; inference not implemented until step7"
  },
  "later_steps": {
    "step6": [
      "dynamic Div/Mod whole-graph integration",
      "complete safety wrapping and reset acceptance"
    ],
    "step7": [
      "offline model inference",
      "domain validation",
      "stage-dependent cost queries and D selection"
    ]
  },
  "extensions": "AES/Sigmoid/fixedpoint/new semantic profiles are reserved and explicitly rejected; no empty providers",
  "no_physical_calls": true,
