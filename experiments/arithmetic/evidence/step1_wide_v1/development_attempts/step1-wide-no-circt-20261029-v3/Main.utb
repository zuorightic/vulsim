#include <cstdio>
#include <cstdlib>
#include <fstream>
#include <string>
#include <run.hpp>
TOP("Top.vul"); PROJECT(".");
REQUEST(push, ARG(Input) value, ARG(bool) valid);
REQUEST(combine, ARG(Input) value, RESP(Output) result);
QUERY(result, Output); QUERY(valid, bool);
REQUEST(echo128, ARG(Int<128>) value, RESP(Int<128>) result);
REQUEST(echo129, ARG(Int<129>) value, RESP(Int<129>) result);
REQUEST(echo193, ARG(Int<193>) value, RESP(Int<193>) result);
REQUEST(echo256, ARG(Int<256>) value, RESP(Int<256>) result);
REQUEST(echo257, ARG(Int<257>) value, RESP(Int<257>) result);

GLOBAL() {
template<uint32_t W> Int<W> read_hex(std::istream& stream) {
    std::string token;
    if (!(stream >> token)) { std::fprintf(stderr,"missing vector token\n"); std::exit(1); }
    Int<W> value{};
    for (size_t n=0; n<token.size(); ++n) {
        char c=token[token.size()-1-n];
        unsigned digit=c>='a' ? unsigned(c-'a'+10) : unsigned(c-'0');
        for (unsigned j=0; j<4; ++j) {
            unsigned bit=unsigned(n)*4+j;
            if (bit<W) value.template pick<1>(bit)=(digit>>j)&1;
            else if ((digit>>j)&1) std::exit(2);
        }
    }
    return value;
}
template<uint32_t W> void print_hex(const Int<W>& value) {
    std::putchar(' ');
    for (int nibble=int((W+3)/4)-1; nibble>=0; --nibble) {
        unsigned digit=0;
        for (unsigned j=0; j<4; ++j) {
            unsigned bit=unsigned(nibble)*4+j;
            if (bit<W && value.template pick<1>(bit).template to<bool>()) digit|=1u<<j;
        }
        std::putchar("0123456789abcdef"[digit]);
    }
}
void print_output(const Output& output) {
    print_hex(Int<16>(output.full8));
    print_hex(Int<8>(output.low8));
    print_hex(Int<17>(output.dot8));
    print_hex(Int<16>(output.mac8));
    print_hex(Int<8>(output.sum8));
    print_hex(Int<9>(output.carry8));
    print_hex(Int<8>(output.diff8));
    print_hex(Int<8>(output.bits8));
    print_hex(Int<8>(output.left8));
    print_hex(Int<8>(output.right8));
    print_hex(Int<1>(output.less8));
    print_hex(Int<32>(output.full16));
    print_hex(Int<16>(output.low16));
    print_hex(Int<33>(output.dot16));
    print_hex(Int<32>(output.mac16));
    print_hex(Int<16>(output.sum16));
    print_hex(Int<17>(output.carry16));
    print_hex(Int<16>(output.diff16));
    print_hex(Int<16>(output.bits16));
    print_hex(Int<16>(output.left16));
    print_hex(Int<16>(output.right16));
    print_hex(Int<1>(output.less16));
    print_hex(Int<64>(output.full32));
    print_hex(Int<32>(output.low32));
    print_hex(Int<65>(output.dot32));
    print_hex(Int<64>(output.mac32));
    print_hex(Int<32>(output.sum32));
    print_hex(Int<33>(output.carry32));
    print_hex(Int<32>(output.diff32));
    print_hex(Int<32>(output.bits32));
    print_hex(Int<32>(output.left32));
    print_hex(Int<32>(output.right32));
    print_hex(Int<1>(output.less32));
    print_hex(Int<128>(output.full64));
    print_hex(Int<64>(output.low64));
    print_hex(Int<129>(output.dot64));
    print_hex(Int<128>(output.mac64));
    print_hex(Int<64>(output.sum64));
    print_hex(Int<65>(output.carry64));
    print_hex(Int<64>(output.diff64));
    print_hex(Int<64>(output.bits64));
    print_hex(Int<64>(output.left64));
    print_hex(Int<64>(output.right64));
    print_hex(Int<1>(output.less64));
    print_hex(Int<256>(output.full128));
    print_hex(Int<128>(output.low128));
    print_hex(Int<257>(output.dot128));
    print_hex(Int<256>(output.mac128));
    print_hex(Int<128>(output.sum128));
    print_hex(Int<129>(output.carry128));
    print_hex(Int<128>(output.diff128));
    print_hex(Int<128>(output.bits128));
    print_hex(Int<128>(output.left128));
    print_hex(Int<128>(output.right128));
    print_hex(Int<1>(output.less128));
    print_hex(Int<257>(output.tag));
    print_hex(Int<257>(output.merged));
    print_hex(Int<256>(output.constant_product));
    print_hex(Int<257>(output.constant_sum));
}
}
SIMULATION() {
    uint32_t echo_checks=0;
    {
        Int<128> value{}, response{};
        for (uint32_t bit=0; bit<128; ++bit) {
            value=0; value.template pick<1>(bit)=1;
            echo128(value,response);
            if (response!=value) std::exit(3);
            sim_nextcycle(); ++echo_checks;
        }
        value=~Int<128>(0); echo128(value,response);
        if (response!=value) std::exit(4);
        sim_nextcycle(); ++echo_checks;
        value=0; echo128(value,response);
        if (response!=value) std::exit(5);
        sim_nextcycle(); ++echo_checks;
    }
    {
        Int<129> value{}, response{};
        for (uint32_t bit=0; bit<129; ++bit) {
            value=0; value.template pick<1>(bit)=1;
            echo129(value,response);
            if (response!=value) std::exit(3);
            sim_nextcycle(); ++echo_checks;
        }
        value=~Int<129>(0); echo129(value,response);
        if (response!=value) std::exit(4);
        sim_nextcycle(); ++echo_checks;
        value=0; echo129(value,response);
        if (response!=value) std::exit(5);
        sim_nextcycle(); ++echo_checks;
    }
    {
        Int<193> value{}, response{};
        for (uint32_t bit=0; bit<193; ++bit) {
            value=0; value.template pick<1>(bit)=1;
            echo193(value,response);
            if (response!=value) std::exit(3);
            sim_nextcycle(); ++echo_checks;
        }
        value=~Int<193>(0); echo193(value,response);
        if (response!=value) std::exit(4);
        sim_nextcycle(); ++echo_checks;
        value=0; echo193(value,response);
        if (response!=value) std::exit(5);
        sim_nextcycle(); ++echo_checks;
    }
    {
        Int<256> value{}, response{};
        for (uint32_t bit=0; bit<256; ++bit) {
            value=0; value.template pick<1>(bit)=1;
            echo256(value,response);
            if (response!=value) std::exit(3);
            sim_nextcycle(); ++echo_checks;
        }
        value=~Int<256>(0); echo256(value,response);
        if (response!=value) std::exit(4);
        sim_nextcycle(); ++echo_checks;
        value=0; echo256(value,response);
        if (response!=value) std::exit(5);
        sim_nextcycle(); ++echo_checks;
    }
    {
        Int<257> value{}, response{};
        for (uint32_t bit=0; bit<257; ++bit) {
            value=0; value.template pick<1>(bit)=1;
            echo257(value,response);
            if (response!=value) std::exit(3);
            sim_nextcycle(); ++echo_checks;
        }
        value=~Int<257>(0); echo257(value,response);
        if (response!=value) std::exit(4);
        sim_nextcycle(); ++echo_checks;
        value=0; echo257(value,response);
        if (response!=value) std::exit(5);
        sim_nextcycle(); ++echo_checks;
    }
    std::ifstream stream("/home/zyrv/vulsim/build/step1-wide-no-circt-20261029-v3/vectors.txt");
    unsigned count=0;
    if (!(stream >> count)) std::exit(6);
    sim_reset();
    std::printf("INITIAL %u",unsigned(valid())); print_output(result()); std::putchar('\n');
    for (unsigned cycle=0; cycle<count; ++cycle) {
        Input input{};
        input.a=read_hex<128>(stream); input.b=read_hex<128>(stream);
        input.c=read_hex<128>(stream); input.d=read_hex<128>(stream);
        input.bias=read_hex<256>(stream); input.tag=read_hex<257>(stream);
        input.shift=read_hex<8>(stream); input.carry=read_hex<1>(stream).to<bool>();
        bool iv=read_hex<1>(stream).to<bool>(), reset=read_hex<1>(stream).to<bool>();
        if (reset) sim_reset();
        Output comb{}; combine(input,comb);
        if (!reset) push(input,iv);
        sim_nextcycle();
        std::printf("ROW %u",cycle); print_output(comb);
        std::printf(" %u",unsigned(valid())); print_output(result()); std::putchar('\n');
    }
    sim_reset();
    std::printf("FINAL %u",unsigned(valid())); print_output(result()); std::putchar('\n');
    std::printf("WIDE RUN PASS rows=%u echo_checks=%u\n",count,echo_checks);
}
