INTERFACE() {
    SERVICE(push, ARG(Input) value, ARG(bool) valid);
    SERVICE(combine, ARG(Input) value, RESP(Output) result);
    QUERY(result, Output); QUERY(valid, bool);
    SERVICE(echo128, ARG(Int<128>) value, RESP(Int<128>) result);
    SERVICE(echo129, ARG(Int<129>) value, RESP(Int<129>) result);
    SERVICE(echo193, ARG(Int<193>) value, RESP(Int<193>) result);
    SERVICE(echo256, ARG(Int<256>) value, RESP(Int<256>) result);
    SERVICE(echo257, ARG(Int<257>) value, RESP(Int<257>) result);
}
PIPELINE(calculate, LATENCY, IREG(input, Input) {input.a=~Int<128>(0); input.b=~Int<128>(0);
input.c=~Int<128>(0); input.d=~Int<128>(0);
input.bias=~Int<256>(0); input.tag=~Int<257>(0); input.shift=127; input.carry=true;
}, IVALID(iv), OREG(output, Output), OVALID(ov)) {
Int<8> a8 = Int<8>(input.a);
Int<8> b8 = Int<8>(input.b);
Int<8> c8 = Int<8>(input.c);
Int<8> d8 = Int<8>(input.d);
Int<16> p8 = a8 * b8;
Int<16> q8 = c8 * d8;
output.full8 = p8;
output.low8 = Int<8>(p8);
output.dot8 = Int<17>(p8) + Int<17>(q8);
output.mac8 = p8 + Int<16>(input.bias);
output.sum8 = a8 + b8;
output.carry8 = AddCarry(a8, b8, input.carry);
output.diff8 = a8 - b8;
output.bits8 = (a8 & b8) ^ (c8 | d8);
output.left8 = a8 << (uint32_t(input.shift) & 7u);
output.right8 = a8 >> (uint32_t(input.shift) & 7u);
output.less8 = a8 < b8;
Int<16> a16 = Int<16>(input.a);
Int<16> b16 = Int<16>(input.b);
Int<16> c16 = Int<16>(input.c);
Int<16> d16 = Int<16>(input.d);
Int<32> p16 = a16 * b16;
Int<32> q16 = c16 * d16;
output.full16 = p16;
output.low16 = Int<16>(p16);
output.dot16 = Int<33>(p16) + Int<33>(q16);
output.mac16 = p16 + Int<32>(input.bias);
output.sum16 = a16 + b16;
output.carry16 = AddCarry(a16, b16, input.carry);
output.diff16 = a16 - b16;
output.bits16 = (a16 & b16) ^ (c16 | d16);
output.left16 = a16 << (uint32_t(input.shift) & 15u);
output.right16 = a16 >> (uint32_t(input.shift) & 15u);
output.less16 = a16 < b16;
Int<32> a32 = Int<32>(input.a);
Int<32> b32 = Int<32>(input.b);
Int<32> c32 = Int<32>(input.c);
Int<32> d32 = Int<32>(input.d);
Int<64> p32 = a32 * b32;
Int<64> q32 = c32 * d32;
output.full32 = p32;
output.low32 = Int<32>(p32);
output.dot32 = Int<65>(p32) + Int<65>(q32);
output.mac32 = p32 + Int<64>(input.bias);
output.sum32 = a32 + b32;
output.carry32 = AddCarry(a32, b32, input.carry);
output.diff32 = a32 - b32;
output.bits32 = (a32 & b32) ^ (c32 | d32);
output.left32 = a32 << (uint32_t(input.shift) & 31u);
output.right32 = a32 >> (uint32_t(input.shift) & 31u);
output.less32 = a32 < b32;
Int<64> a64 = Int<64>(input.a);
Int<64> b64 = Int<64>(input.b);
Int<64> c64 = Int<64>(input.c);
Int<64> d64 = Int<64>(input.d);
Int<128> p64 = a64 * b64;
Int<128> q64 = c64 * d64;
output.full64 = p64;
output.low64 = Int<64>(p64);
output.dot64 = Int<129>(p64) + Int<129>(q64);
output.mac64 = p64 + Int<128>(input.bias);
output.sum64 = a64 + b64;
output.carry64 = AddCarry(a64, b64, input.carry);
output.diff64 = a64 - b64;
output.bits64 = (a64 & b64) ^ (c64 | d64);
output.left64 = a64 << (uint32_t(input.shift) & 63u);
output.right64 = a64 >> (uint32_t(input.shift) & 63u);
output.less64 = a64 < b64;
Int<128> a128 = Int<128>(input.a);
Int<128> b128 = Int<128>(input.b);
Int<128> c128 = Int<128>(input.c);
Int<128> d128 = Int<128>(input.d);
Int<256> p128 = a128 * b128;
Int<256> q128 = c128 * d128;
output.full128 = p128;
output.low128 = Int<128>(p128);
output.dot128 = Int<257>(p128) + Int<257>(q128);
output.mac128 = p128 + Int<256>(input.bias);
output.sum128 = a128 + b128;
output.carry128 = AddCarry(a128, b128, input.carry);
output.diff128 = a128 - b128;
output.bits128 = (a128 & b128) ^ (c128 | d128);
output.left128 = a128 << (uint32_t(input.shift) & 127u);
output.right128 = a128 >> (uint32_t(input.shift) & 127u);
output.less128 = a128 < b128;
output.tag = input.tag;
output.merged = output.dot128 ^ input.tag;
output.constant_product = (~Int<128>(0)) * (~Int<128>(0));
output.constant_sum = AddCarry(output.constant_product, output.constant_product, true);
}
SERVICE(push, ARG(Input) value, ARG(bool) valid) { input.setnext(value); iv.setnext(valid); }
QUERY(result, Output) { return output.get(); }
QUERY(valid, bool) { return ov; }
SERVICE(combine, ARG(Input) value, RESP(Output) result) {
Int<8> a8 = Int<8>(value.a);
Int<8> b8 = Int<8>(value.b);
Int<8> c8 = Int<8>(value.c);
Int<8> d8 = Int<8>(value.d);
Int<16> p8 = a8 * b8;
Int<16> q8 = c8 * d8;
result.full8 = p8;
result.low8 = Int<8>(p8);
result.dot8 = Int<17>(p8) + Int<17>(q8);
result.mac8 = p8 + Int<16>(value.bias);
result.sum8 = a8 + b8;
result.carry8 = AddCarry(a8, b8, value.carry);
result.diff8 = a8 - b8;
result.bits8 = (a8 & b8) ^ (c8 | d8);
result.left8 = a8 << (uint32_t(value.shift) & 7u);
result.right8 = a8 >> (uint32_t(value.shift) & 7u);
result.less8 = a8 < b8;
Int<16> a16 = Int<16>(value.a);
Int<16> b16 = Int<16>(value.b);
Int<16> c16 = Int<16>(value.c);
Int<16> d16 = Int<16>(value.d);
Int<32> p16 = a16 * b16;
Int<32> q16 = c16 * d16;
result.full16 = p16;
result.low16 = Int<16>(p16);
result.dot16 = Int<33>(p16) + Int<33>(q16);
result.mac16 = p16 + Int<32>(value.bias);
result.sum16 = a16 + b16;
result.carry16 = AddCarry(a16, b16, value.carry);
result.diff16 = a16 - b16;
result.bits16 = (a16 & b16) ^ (c16 | d16);
result.left16 = a16 << (uint32_t(value.shift) & 15u);
result.right16 = a16 >> (uint32_t(value.shift) & 15u);
result.less16 = a16 < b16;
Int<32> a32 = Int<32>(value.a);
Int<32> b32 = Int<32>(value.b);
Int<32> c32 = Int<32>(value.c);
Int<32> d32 = Int<32>(value.d);
Int<64> p32 = a32 * b32;
Int<64> q32 = c32 * d32;
result.full32 = p32;
result.low32 = Int<32>(p32);
result.dot32 = Int<65>(p32) + Int<65>(q32);
result.mac32 = p32 + Int<64>(value.bias);
result.sum32 = a32 + b32;
result.carry32 = AddCarry(a32, b32, value.carry);
result.diff32 = a32 - b32;
result.bits32 = (a32 & b32) ^ (c32 | d32);
result.left32 = a32 << (uint32_t(value.shift) & 31u);
result.right32 = a32 >> (uint32_t(value.shift) & 31u);
result.less32 = a32 < b32;
Int<64> a64 = Int<64>(value.a);
Int<64> b64 = Int<64>(value.b);
Int<64> c64 = Int<64>(value.c);
Int<64> d64 = Int<64>(value.d);
Int<128> p64 = a64 * b64;
Int<128> q64 = c64 * d64;
result.full64 = p64;
result.low64 = Int<64>(p64);
result.dot64 = Int<129>(p64) + Int<129>(q64);
result.mac64 = p64 + Int<128>(value.bias);
result.sum64 = a64 + b64;
result.carry64 = AddCarry(a64, b64, value.carry);
result.diff64 = a64 - b64;
result.bits64 = (a64 & b64) ^ (c64 | d64);
result.left64 = a64 << (uint32_t(value.shift) & 63u);
result.right64 = a64 >> (uint32_t(value.shift) & 63u);
result.less64 = a64 < b64;
Int<128> a128 = Int<128>(value.a);
Int<128> b128 = Int<128>(value.b);
Int<128> c128 = Int<128>(value.c);
Int<128> d128 = Int<128>(value.d);
Int<256> p128 = a128 * b128;
Int<256> q128 = c128 * d128;
result.full128 = p128;
result.low128 = Int<128>(p128);
result.dot128 = Int<257>(p128) + Int<257>(q128);
result.mac128 = p128 + Int<256>(value.bias);
result.sum128 = a128 + b128;
result.carry128 = AddCarry(a128, b128, value.carry);
result.diff128 = a128 - b128;
result.bits128 = (a128 & b128) ^ (c128 | d128);
result.left128 = a128 << (uint32_t(value.shift) & 127u);
result.right128 = a128 >> (uint32_t(value.shift) & 127u);
result.less128 = a128 < b128;
result.tag = value.tag;
result.merged = result.dot128 ^ value.tag;
result.constant_product = (~Int<128>(0)) * (~Int<128>(0));
result.constant_sum = AddCarry(result.constant_product, result.constant_product, true);
}
SERVICE(echo128, ARG(Int<128>) value, RESP(Int<128>) result) { result=value; }
SERVICE(echo129, ARG(Int<129>) value, RESP(Int<129>) result) { result=value; }
SERVICE(echo193, ARG(Int<193>) value, RESP(Int<193>) result) { result=value; }
SERVICE(echo256, ARG(Int<256>) value, RESP(Int<256>) result) { result=value; }
SERVICE(echo257, ARG(Int<257>) value, RESP(Int<257>) result) { result=value; }
