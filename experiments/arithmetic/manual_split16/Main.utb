#include <cstdio>
#include <cstdlib>
#include <cstdint>
#include <run.hpp>
#include "header.uh"

TOP("Top.vul");
PROJECT(".");
REQUEST(write_a, ARG(Int<32>) value);
REQUEST(write_b, ARG(Int<32>) value);
REQUEST(write_c, ARG(Int<64>) value);
REQUEST(write_valid, ARG(bool) value);
QUERY(result, Int<64>);
QUERY(valid, bool);

SIMULATION() {
    struct State {
        uint32_t a=0x80000035u, b=0x80000035u;
        uint64_t c=0x8000000000000035ULL;
        bool iv=false;
        uint32_t p00=0xaf9u, p01=0x1a8000u, p10=0x1a8000u, p11=0x40000000u;
        uint64_t c1=0x8000000000000035ULL;
        bool v1=false;
    } state;
    uint64_t rng=0x71482a5c196db03fULL;
    auto random=[&]() { rng^=rng<<13; rng^=rng>>7; rng^=rng<<17; return rng; };
    unsigned checked=0, valid_checked=0;
    sim_reset();
    if (result()!=Int<64>(0xc000003500000b2eULL) || valid()) {
        std::printf("MANUAL_SPLIT16_FAIL initial reset\n"); std::exit(1);
    }
    for (unsigned cycle=0; cycle<320; ++cycle) {
        if (cycle==127 || cycle==128) { sim_reset(); state=State{}; }
        uint32_t av=uint32_t(random()), bv=uint32_t(random());
        uint64_t cv=random();
        if (cycle<8) {
            constexpr uint32_t edges[8]={0,1,0xffffffffu,0x80000000u,0xffffu,0x10000u,0x7fffffffu,0x12345678u};
            av=edges[cycle]; bv=edges[7-cycle]; cv=cycle&1?UINT64_MAX:0;
        }
        bool wa=cycle%5!=1, wb=cycle%7!=2, wc=cycle%3!=1;
        bool wv=cycle%6!=3, vv=cycle%4!=1;
        if (wa) write_a(Int<32>(av));
        if (wb) write_b(Int<32>(bv));
        if (wc) write_c(Int<64>(cv));
        if (wv) write_valid(vv);

        uint64_t expected=uint64_t(state.p00)+(uint64_t(state.p01)<<16)+(uint64_t(state.p10)<<16)+(uint64_t(state.p11)<<32)+state.c1;
        bool expected_valid=state.v1;
        State next=state;
        next.v1=state.iv;
        if (state.iv) {
            uint32_t al=state.a&0xffffu, ah=state.a>>16, bl=state.b&0xffffu, bh=state.b>>16;
            next.p00=al*bl; next.p01=al*bh; next.p10=ah*bl; next.p11=ah*bh; next.c1=state.c;
        }
        if (wa) next.a=av;
        if (wb) next.b=bv;
        if (wc) next.c=cv;
        if (wv) next.iv=vv;
        sim_nextcycle();
        if (result()!=Int<64>(expected) || valid()!=expected_valid) {
            std::printf("MANUAL_SPLIT16_FAIL cycle=%u expected=%016llx actual=%016llx valid=%u/%u\n",cycle,
                (unsigned long long)expected,(unsigned long long)result().to<uint64_t>(),unsigned(expected_valid),unsigned(valid()));
            std::exit(1);
        }
        state=next; ++checked; if (expected_valid) ++valid_checked;
    }
    std::printf("MANUAL_SPLIT16_PASS cycles=%u valid=%u independent_writes=1 held_valid=1 reset=1\n",checked,valid_checked);
}
